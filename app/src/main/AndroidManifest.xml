<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Proximity barge-in's call guard. AssistantService.isPhoneCallActive() reads the
        coarse call state at trigger time so a wave-to-interrupt gesture is skipped while
        a call is ringing/off-hook (holding the phone to the ear for a real call must not
        stop playback). On API 31+ the framework enforces READ_PHONE_STATE on that read
        for apps targeting 31 or newer, and this app targets 37: the Telephony -> Telecom
        path throws SecurityException("getCallState API requires READ_PHONE_STATE for API
        version 31+") instead of returning CALL_STATE_IDLE. Without this declaration the
        guard's read failed on EVERY trigger, so the guard could never skip. Requested at
        runtime alongside RECORD_AUDIO/POST_NOTIFICATIONS; declining it is fully supported
        and the guard then degrades to "no call detected", which is exactly its pre-fix
        behaviour. Nothing else in the app depends on this permission.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
        <application
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceAssistant">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VoiceAssistant"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Share target: ONE text/plain item or ONE image/*. Deliberately no "*/*" and no
                ACTION_SEND_MULTIPLE yet — the app lands a single item in the composer.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
            Quick Settings tile. Exported only to SystemUI, which holds the signature permission
            BIND_QUICK_SETTINGS_TILE. The tile never touches AssistantService; it opens
            MainActivity with a one-shot extra and the app owns the decision.
        -->
        <service
            android:name=".CelesteTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_celeste"
            android:label="@string/tile_celeste_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".AssistantService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>